---
import { formatDate } from '@/lib/utils'
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'
import Link from './link.astro'

interface Props {
  entry: CollectionEntry<'blog'> | CollectionEntry<'news'>
}

const { entry } = Astro.props
const formattedDate = formatDate(entry.data.date)
const isBlog = entry.collection === 'blog'
const isNews = entry.collection === 'news'
---

<div class="blog-card">
  <Link href={`/${entry.collection}/${entry.id}`} class="blog-card-link">
    {
      entry.data.image && (
        <div class="blog-card-image-wrapper">
          <Image
            src={entry.data.image}
            alt={entry.data.title}
            width={1200}
            height={630}
            class="blog-card-image"
          />
        </div>
      )
    }

    <div class="blog-card-content">
      <!-- Плашка с типом контента -->
      <div class="badge-wrapper">
        {isBlog && <span class="badge badge-article">Пост</span>}
        {isNews && <span class="badge badge-news">Новости</span>}
      </div>

      <h3 class="blog-card-title">{entry.data.title}</h3>
      <p class="blog-card-description">{entry.data.description}</p>

      <div class="blog-card-meta">
        <span>{formattedDate}</span>
      </div>
    </div>
  </Link>
</div>

<style>
  /* === 1. ОСНОВНАЯ КАРТОЧКА === */
  .blog-card {
    border-right: 2px solid transparent;
    border-bottom: 1px solid oklch(0.32 0.03 60);
    background-color: transparent;
    transition:
      border-right-color 1.2s ease,
      background-color 1.2s ease;
  }

  .blog-card:hover {
    background-color: color-mix(in oklch, oklch(0.85 0.03 60) 10%, transparent);
    transition:
      background-color 1.2s ease,
      border-right-color 1.2s ease;
    border-right-color: var(--card-hover);
  }

  .blog-card-link {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1rem;
    text-decoration: none;
    color: inherit;
  }

  @media (min-width: 640px) {
    .blog-card-link {
      flex-direction: row;
    }
  }

  /* === 2. ИЗОБРАЖЕНИЕ === */
  .blog-card-image-wrapper {
    width: 100%;
    flex-shrink: 0;
  }

  @media (min-width: 640px) {
    .blog-card-image-wrapper {
      max-width: 12rem; /* sm:max-w-3xs */
    }
  }

  .blog-card-image {
    width: 100%;
    height: auto;
    object-fit: cover;
    border-radius: 0.5rem;
  }

  /* === 3. КОНТЕНТ === */
  .blog-card-content {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .badge-wrapper {
    margin-bottom: 0.5rem;
  }

  .blog-card-title {
    margin: 0 0 0.5rem 0;
    font-size: 1.125rem; /* text-lg */
    font-weight: 500;
    line-height: 1.4;
    color: var(--foreground);
  }

  .blog-card-description {
    margin: 0 0 0.75rem 0;
    font-size: 0.875rem; /* text-sm */
    color: var(--muted-foreground);
    line-height: 1.5;
    /* Ограничиваем описание 2-3 строками для аккуратности */
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .blog-card-meta {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem; /* text-xs */
    color: var(--muted-foreground);
  }

  /* === 4. БЕЙДЖИ (ТИХАЯ ГАВАНЬ) === */
  .badge {
    display: inline-block;
    padding: 0.25rem 0.625rem;
    font-size: 0.75rem;
    font-weight: 500;
    border-radius: 0.375rem;
    line-height: 1;
    transition: background-color 0.2s ease;
  }

  /* Статья: максимально спокойная, нейтральная */
  .badge-article {
    background-color: color-mix(
      in oklch,
      var(--primary-article) 15%,
      transparent
    );
    color: var(--primary-article);
    border: 1px solid
      color-mix(in oklch, var(--primary-article) 30%, transparent);
  }

  .badge-news {
    background-color: color-mix(in oklch, var(--primary) 15%, transparent);
    color: var(--primary);
    border: 1px solid color-mix(in oklch, var(--primary) 30%, transparent);
  }
</style>

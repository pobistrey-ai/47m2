---
import Link from '@/components/link.astro'
import ThemeToggle from '@/components/theme-toggle.astro'
import { NAV_LINKS, SITE } from '@/consts'
---

<header class="site-header">
  <div class="header-inner">
    <!-- Логотип и название -->
    <Link href="/" class="site-logo">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="40"
        height="40"
        fill="currentColor"
        viewBox="0 0 256 256"
      >
        <!-- Квадрат с глубокими отгрызенными треугольниками в правом нижнем углу -->
        <path
          d="M 52 40 L 204 40 Q 216 40 216 52 L 216 175 L 190 190 L 215 200 L 180 210 L 210 215 L 170 216 L 52 216 Q 40 216 40 204 L 40 52 Q 40 40 52 40 Z"
          fill="none"
          stroke="currentColor"
          stroke-width="12"
          stroke-linejoin="round"></path>
        <!-- Цифры 47 -->
        <text
          x="128"
          y="165"
          font-family="Arial, sans-serif"
          font-size="110"
          font-weight="bold"
          text-anchor="middle"
          fill="currentColor">47</text
        >
      </svg>
      <span class="site-title">{SITE.title}</span>
    </Link>

    <!-- Навигация и переключатель темы -->
    <div class="header-actions">
      <!-- Десктопная навигация -->
      <nav class="site-nav">
        {
          NAV_LINKS.map((item) => {
            const isActive =
              item.href === '/'
                ? Astro.url.pathname === '/'
                : Astro.url.pathname.startsWith(item.href)
            return (
              <Link
                href={item.href}
                class:list={['nav-link', { active: isActive }]}
              >
                {item.label}
              </Link>
            )
          })
        }
      </nav>

      <div class="theme-toggle-wrapper">
        <ThemeToggle transition:persist />
      </div>

      <!-- Кнопка мобильного меню -->
      <button
        class="mobile-menu-toggle"
        popovertarget="mobile-menu"
        popovertargetaction="toggle"
        aria-label="Открыть меню"
        aria-expanded="false"
      >
        <svg
          class="menu-icon"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Мобильное меню (Popover) -->
<nav class="mobile-menu" id="mobile-menu" popover>
  <div class="mobile-menu-inner">
    {
      NAV_LINKS.map((item) => {
        const isActive =
          item.href === '/'
            ? Astro.url.pathname === '/'
            : Astro.url.pathname.startsWith(item.href)
        return (
          <Link
            href={item.href}
            class:list={['mobile-nav-link', { active: isActive }]}
            popovertarget="mobile-menu"
            popovertargetaction="hide"
          >
            {item.label}
          </Link>
        )
      })
    }
  </div>
</nav>

<style>
  /* === ЛОГОТИП === */
  .site-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    flex-shrink: 0;
    transition: filter 1.2s cubic-bezier(0.4, 0, 0.2, 1);
    filter: drop-shadow(
      0 0 1px color-mix(in oklch, var(--white-warm) 15%, transparent)
    );
  }

  .site-logo:hover {
    filter: drop-shadow(0 0 8px var(--white-warm));
  }

  .logo-svg {
    width: 2rem;
    height: 2rem;
    color: var(--white-warm);
    display: block;
  }

  .site-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--foreground);
    white-space: nowrap;
  }

  /* === ХЕДЕР === */
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    width: 100%;
    min-height: 4rem;
    padding-block: 1rem;
    background: var(--header-bg);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: var(--header-shadow);
    display: flex;
    align-items: center;
    transition: transform 0.3s ease-in-out;
    height: 4rem;
    max-height: 4rem;
    overflow: hidden;
  }

  .site-header.is-hidden {
    transform: translateY(-100%);
  }

  /* === ВНУТРЕННИЙ КОНТЕЙНЕР === */
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: 72rem;
    margin: 0 auto;
    padding-inline: 2rem;
    box-sizing: border-box;
  }

  /* === ПРАВАЯ ЧАСТЬ === */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 2.5rem;
  }

  /* === ССЫЛКИ МЕНЮ === */
  .nav-link {
    position: relative;
    padding: 0.375rem 0.75rem;
    border-radius: 0.375rem;
    font-size: 1.125rem;
    font-weight: 500;
    text-decoration: none;
    text-transform: capitalize;
    border: 1px solid transparent;
    color: color-mix(in oklch, var(--foreground) 70%, transparent);
    background-color: transparent;
    transition:
      border-color 1.2s ease,
      color 1.2s ease,
      background-color 1.2s ease;
  }

  .nav-link:hover {
    border-color: color-mix(in oklch, var(--white-warm) 40%, transparent);
    color: var(--white-warm);
    background-color: color-mix(in oklch, var(--white-warm) 8%, transparent);
  }

  /* === АКТИВНЫЙ ПУНКТ МЕНЮ === */
  .nav-link.active {
    color: var(--white-warm);
    background-color: color-mix(in oklch, var(--white-warm) 8%, transparent);
    border-color: transparent;
  }

  /* === КНОПКА МОБИЛЬНОГО МЕНЮ === */
  .mobile-menu-toggle {
    display: none;
    background: none;
    border: 1px solid transparent;
    color: var(--foreground);
    cursor: pointer;
    padding: 0.5rem;
    border-radius: 0.375rem;
    transition:
      border-color 0.3s ease,
      color 0.3s ease;
  }

  .mobile-menu-toggle:hover {
    border-color: color-mix(in oklch, var(--white-warm) 40%, transparent);
    color: var(--white-warm);
  }

  .menu-icon {
    width: 1.5rem;
    height: 1.5rem;
    display: block;
  }

  /* === MOBILE MENU (POPOVER) === */
  .mobile-menu {
    opacity: 0;
    transform: translateY(-0.5rem);
    transition:
      opacity 0.3s ease,
      transform 0.3s ease,
      display 0.3s ease allow-discrete,
      overlay 0.3s ease allow-discrete;

    position: fixed;
    top: calc(4rem + 0.5rem);
    left: 1rem;
    right: 1rem;
    max-width: calc(100vw - 2rem);
    z-index: 100;

    /* background: linear-gradient(180deg, #1a1a1f 0%, #24242a 100%); */
    background: var(--mobile-menu);

    border: 1px solid color-mix(in oklch, var(--white-warm) 20%, transparent);
    border-radius: 0.75rem;
    box-shadow:
      0 10px 40px rgba(0, 0, 0, 0.5),
      0 0 0 1px rgba(255, 255, 255, 0.05);
    padding: 0.75rem;

    margin: 0;
    inset: auto;
    width: auto;
    max-height: none;
    overflow: visible;
  }

  .mobile-menu:popover-open {
    opacity: 1;
    transform: translateY(0);
  }

  @starting-style {
    .mobile-menu:popover-open {
      opacity: 0;
      transform: translateY(-0.5rem);
    }
  }

  .mobile-menu-inner {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .mobile-nav-link {
    display: block;
    padding: 0.875rem 1rem;
    font-size: 1.125rem;
    font-weight: 500;
    color: color-mix(in oklch, var(--foreground) 70%, transparent);
    text-decoration: none;
    border-radius: 0.5rem;
    /* transition:
      background-color 0.2s ease,
      color 0.2s ease; */
    text-transform: capitalize;
  }

  .mobile-nav-link:hover {
    background-color: color-mix(in oklch, var(--white-warm) 8%, transparent);
    color: var(--white-warm);
  }

  /* === АКТИВНЫЙ ПУНКТ МОБИЛЬНОГО МЕНЮ === */
  .mobile-nav-link.active {
    color: var(--white-warm);
    background-color: color-mix(in oklch, var(--white-warm) 8%, transparent);
  }

  /* === МОБИЛЬНЫЙ АДАПТИВ (< 640px) === */
  @media (max-width: 640px) {
    .site-header {
      min-height: 3.5rem;
      padding-block: 0.75rem;
    }

    .header-inner {
      padding-inline: 1rem;
      justify-content: flex-start;
      gap: 1rem;
    }

    .header-actions {
      margin-left: auto;
      gap: 0.75rem;
    }

    .site-nav {
      display: none;
    }

    .mobile-menu-toggle {
      display: block;
    }

    .nav-link {
      font-size: 1rem;
    }

    .mobile-menu {
      top: calc(3.5rem + 0.5rem);
      left: 0.75rem;
      right: 0.75rem;
      max-width: calc(100vw - 1.5rem);
    }
  }

  /* === ОЧЕНЬ УЗКИЕ ЭКРАНЫ (< 400px) === */
  @media (max-width: 400px) {
    .header-inner {
      padding-inline: 0.75rem;
    }

    .mobile-menu {
      left: 0.5rem;
      right: 0.5rem;
      max-width: calc(100vw - 1rem);
    }

    .mobile-nav-link {
      padding: 0.75rem 0.875rem;
      font-size: 1rem;
    }
  }
</style>

<script>
  const header = document.querySelector('.site-header')
  if (!header) {
    console.warn('Header element not found')
  } else {
    const headerElement = header as HTMLElement // ← явное приведение типа
    let lastScrollY = window.scrollY

    window.addEventListener(
      'scroll',
      () => {
        const currentScrollY = window.scrollY

        if (currentScrollY > lastScrollY && currentScrollY > 50) {
          headerElement.style.transform = 'translateY(-100%)'
        } else if (currentScrollY < lastScrollY) {
          headerElement.style.transform = 'translateY(0)'
        } else if (currentScrollY <= 50) {
          headerElement.style.transform = 'translateY(0)'
        }

        lastScrollY = currentScrollY
      },
      { passive: true },
    )
  }
</script>
